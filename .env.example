# Required for AI parsing/recommendations (falls back to a basic parser without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Default departure airport when the request doesn't mention one
HOME_AIRPORT=BRU

# Flights: "mock" (demo prices) or "amadeus" (real offers)
FLIGHT_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
PORT=3000
