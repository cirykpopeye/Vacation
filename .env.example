# AI for understanding requests + writing recommendations. Set ONE of these
# (falls back to a basic parser without any). If both are set, DeepSeek is used unless LLM_PROVIDER says otherwise.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: force "deepseek" or "anthropic"
LLM_PROVIDER=

# Default departure airport when the request doesn't mention one
HOME_AIRPORT=BRU

# Flights (both free tiers; Amadeus Self-Service was shut down in July 2026)
# Stage 1, cached prices, free signup: https://www.travelpayouts.com  (Tools > API token)
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts partner/marker id. Adds it to booking links so you earn commission on bookings.
TRAVELPAYOUTS_MARKER=
# Stage 2, live check for your party size, 250 free searches/month: https://serpapi.com
SERPAPI_KEY=
# How many top options to verify live per search (each costs 1 SerpApi search)
VERIFY_TOP=4
# Set to 1 if SerpApi prices turn out to be the total for all adults
SERPAPI_PRICE_IS_TOTAL=0
# "auto" (use real providers when keys exist) or "mock" (demo prices)
FLIGHT_PROVIDER=auto
PORT=3000

# --- API access (set these before exposing the server) ---
# Clients send this as "x-api-key: <key>" or "Authorization: Bearer <key>". Unset = open (local dev only!)
API_KEY=
# Allow browser calls from your own system, e.g. https://my-system.example (or * for any)
CORS_ORIGIN=
RATE_LIMIT_PER_MIN=20
